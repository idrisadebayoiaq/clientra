# Public
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase server
SUPABASE_SERVICE_ROLE_KEY=

# OpenRouter
OPENROUTER_API_KEY=
AI_MODEL=anthropic/claude-sonnet-5
AI_FAST_MODEL=google/gemini-3.7-flash
AI_REASONING_MODEL=anthropic/claude-opus-5

# Google OAuth for Gmail integration (not the Supabase Auth callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_CLOUD_PROJECT_NUMBER=
GOOGLE_REDIRECT_URI=https://clientra-xi-rouge.vercel.app/api/auth/google/callback
GOOGLE_REDIRECT_URI_PRODUCTION=https://clientra-xi-rouge.vercel.app/api/auth/google/callback

# Google Pub/Sub
GOOGLE_PUBSUB_TOPIC=
GOOGLE_PUBSUB_SUBSCRIPTION=

# Google Maps / Places (Find Opportunity local business search)
GOOGLE_MAPS_API_KEY=

# Urlscan website discovery
URLSCAN_API_KEY=

# Apollo company discovery
APOLLO_API_KEY=

# Adzuna job discovery
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Optional Omkar contact enrichment
# Sign up: https://www.omkar.cloud/auth/sign-up?redirect=/api-key
# Auth header used by Clientra: API-Key
# Endpoint: https://website-email-contact-scraper.omkar.cloud/website-email-contact/v1/contacts
OMKAR_API_KEY=
# Leave blank to use the Omkar hosted base URL above
OMKAR_CONTACT_API_URL=
RAPIDAPI_KEY=
RAPIDAPI_HOST=
