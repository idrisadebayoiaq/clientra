# Google OAuth for Gmail integration (not the Supabase Auth callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_CLOUD_PROJECT_NUMBER=
GOOGLE_REDIRECT_URI=https://clientra-xi.vercel.app/api/auth/google/callback
GOOGLE_REDIRECT_URI_PRODUCTION=https://clientra-xi.vercel.app/api/auth/google/callback

# Google Pub/Sub
GOOGLE_PUBSUB_TOPIC=
GOOGLE_PUBSUB_SUBSCRIPTION=

# Urlscan website discovery
URLSCAN_API_KEY=

# Apollo company discovery
APOLLO_API_KEY=

# Adzuna job discovery
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
